{
  "name": "status_bot",
  "version": "1.0.0",
  "description": "Discord Bot fuer DayZ Server-Status mit Live-Spieleranzeige, Verlaufsgraph und Uptime-Tracking",
  "type": "module",
  "main": "src/index.js",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning src/index.js",
    "dev": "node --watch --disable-warning=ExperimentalWarning src/index.js",
    "selftest": "node --disable-warning=ExperimentalWarning scripts/selftest.js",
    "preview": "node --disable-warning=ExperimentalWarning scripts/preview-chart.js",
    "invite": "node --disable-warning=ExperimentalWarning scripts/invite.js",
    "diag:rcon": "node --disable-warning=ExperimentalWarning scripts/diag-rcon.js",
    "diag:players": "node --disable-warning=ExperimentalWarning scripts/diag-players.js",
    "selftest:ranking": "node --disable-warning=ExperimentalWarning scripts/selftest-ranking.js"
  },
  "license": "MIT",
  "dependencies": {
    "@napi-rs/canvas": "^1.0.8",
    "discord.js": "^14.27.0",
    "dotenv": "^17.4.2",
    "gamedig": "^5.3.3"
  }
}
