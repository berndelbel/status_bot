# systemd-Service fuer den DayZ-Status-Bot.
#
# EMPFOHLEN: statt diese Datei von Hand anzupassen, einfach
#
#   sudo bash deploy/install-service.sh
#
# ausfuehren. Das Skript ermittelt Projektpfad, Benutzer und Node-Pfad selbst
# und erzeugt daraus eine passende Unit.
#
# Manuelle Installation (als root):
#   cp deploy/status-bot.service /etc/systemd/system/
#   nano /etc/systemd/system/status-bot.service   # Platzhalter unten ersetzen
#   systemctl daemon-reload
#   systemctl enable --now status-bot
#
# Logs ansehen:  journalctl -u status-bot -f

[Unit]
Description=DayZ Status Bot (Discord)
After=network-online.target
Wants=network-online.target

# Nach 5 Fehlstarts in 5 Minuten aufgeben, statt endlos zu rotieren.
# Achtung: Diese beiden Schluessel gehoeren seit systemd 229 in [Unit].
# In [Service] werden sie stillschweigend ignoriert.
StartLimitBurst=5
StartLimitIntervalSec=300

[Service]
Type=simple

# --- Anpassen: Benutzer und Projektpfad ---
User=statusbot
Group=statusbot
WorkingDirectory=/opt/status-bot

# dotenv liest die .env aus dem WorkingDirectory.
# Pfad zu node ggf. anpassen (ermitteln mit: command -v node).
ExecStart=/usr/bin/node --disable-warning=ExperimentalWarning src/index.js

# Bei Absturz oder Verbindungsverlust automatisch neu starten.
Restart=always
RestartSec=10

Environment=NODE_ENV=production

# Logs landen im journal.
StandardOutput=journal
StandardError=journal
SyslogIdentifier=status-bot

# --- Absicherung ---
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true

# ACHTUNG: ProtectHome macht /home UND /root schreibgeschuetzt. Liegt das
# Projekt in einem Home-Verzeichnis (z. B. /root/status_bot), kann der Bot
# dann seine Datenbank nicht anlegen - in dem Fall diese Zeile entfernen.
ProtectHome=read-only

# Das Projektverzeichnis muss beschreibbar bleiben (Datenbank).
ReadWritePaths=/opt/status-bot

[Install]
WantedBy=multi-user.target
