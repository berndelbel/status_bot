# ============================================================
#  DISCORD  (Pflicht)
# ============================================================
# Bot-Token aus dem Developer Portal -> Bot -> Reset Token
DISCORD_TOKEN=

# Application ID aus dem Developer Portal -> General Information
CLIENT_ID=

# Channel-ID, in der die dauerhafte Status-Nachricht stehen soll.
# (Discord: Entwicklermodus aktivieren, dann Rechtsklick auf den Channel -> ID kopieren)
STATUS_CHANNEL_ID=

# Server-ID (Guild). Optional, aber empfohlen: die Slash-Commands sind dann
# sofort verfuegbar statt erst nach bis zu einer Stunde.
GUILD_ID=

# ============================================================
#  DAYZ-SERVER  (Pflicht: SERVER_HOST)
# ============================================================
# IP oder Hostname deines Servers
SERVER_HOST=

# Spiel-Port (Standard 2302)
SERVER_PORT=2302

# Query-Port. Leer lassen! Wird automatisch ermittelt (meist Spielport + 24714,
# also 27016). Nur setzen, wenn dein Hoster einen abweichenden Port nennt.
SERVER_QUERY_PORT=

# Eigener Anzeigename statt des Namens, den der Server meldet. Optional.
SERVER_NAME=

# ============================================================
#  BATTLEYE RCON  (optional - fuer Spielernamen und Spielzeit-Ranking)
# ============================================================
# Die Serverabfrage (A2S) liefert bei DayZ grundsaetzlich KEINE Spielernamen.
# Wer ein Ranking will, braucht RCon. Zugangsdaten stehen in der
# beserver_x64.cfg deines DayZ-Servers.
RCON_ENABLED=false

# Leer lassen, wenn RCon auf derselben Adresse wie der Spielserver laeuft.
RCON_HOST=

# RConPort aus der beserver_x64.cfg (haeufig Spielport + 4, also 2306).
RCON_PORT=2306

# RConPassword aus der beserver_x64.cfg.
RCON_PASSWORD=

RANKING_CHANNEL_ID=1546576693957894236
RANKING_DAYS=30
RANKING_UPDATE_INTERVAL=600
RANKING_PAGE_SIZE=10

# ============================================================
#  ROLLEN ZUM SELBST AUSSUCHEN  (optional)
# ============================================================
# Channel-ID fuer die Rollen-Nachricht. Leer = Funktion aus.
ROLES_CHANNEL_ID=

# Welche Rollen angeboten werden, steht in dieser JSON-Datei.
# Vorlage: config/roles.example.json nach config/roles.json kopieren.
ROLES_FILE=./config/roles.json

# ============================================================
#  WILLKOMMENSNACHRICHT  (optional)
# ============================================================
# ACHTUNG: Sobald hier eine Channel-ID steht, braucht der Bot den
# privilegierten Intent "SERVER MEMBERS" im Developer Portal:
#   discord.com/developers -> App -> Bot -> Privileged Gateway Intents
# Ohne ihn verweigert Discord die Anmeldung komplett.
# Leer lassen = Funktion aus, dann bleibt alles wie bisher.
WELCOME_CHANNEL_ID=

# Text und Aufbau der Nachricht.
# Vorlage: config/welcome.example.json nach config/welcome.json kopieren.
WELCOME_FILE=./config/welcome.json

# Sollen auch Bots begruesst werden?
WELCOME_GREET_BOTS=false

# ============================================================
#  VERHALTEN
# ============================================================
# Wie oft der Server abgefragt und ein Messpunkt gespeichert wird (Sekunden).
# Kleinere Werte = feinerer Verlauf, aber mehr Last. Minimum 15.
POLL_INTERVAL=60

# Wie oft die Discord-Nachricht neu geschrieben wird (Sekunden). Minimum 15.
UPDATE_INTERVAL=60

# Zeitraum des Graphen in der Status-Nachricht (Stunden).
CHART_HOURS=24

# Wie lange Messwerte aufbewahrt werden (Tage).
RETENTION_DAYS=30

# Spielerliste mit abfragen. Die meisten DayZ-Server geben keine Namen preis.
SHOW_PLAYER_LIST=true

# ============================================================
#  OPTIK
# ============================================================
# Akzentfarbe fuer Embed-Rand und Graph (Hex).
ACCENT_COLOR=#3BA55D

# Farbe, wenn der Server offline ist.
OFFLINE_COLOR=#ED4245

# Kleines Bild oben rechts im Embed, z. B. dein Server-Logo. Optional.
MAP_IMAGE_URL=

# Zeitzone fuer die Beschriftung der Zeitachse.
TIMEZONE=Europe/Berlin

# ============================================================
#  SONSTIGES
# ============================================================
# Speicherort der Datenbank.
DB_PATH=./data/status.db

# Ausfuehrliche Log-Ausgaben.
DEBUG=false
